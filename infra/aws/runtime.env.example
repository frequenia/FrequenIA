APP_ENV=production
FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_TOKEN_MINUTES=30
EMAILJS_TIMEOUT_SECONDS=10
CORS_ALLOWED_ORIGINS=https://your-subdomain.duckdns.org
FACE_VERIFICATION_MAX_COSINE_DISTANCE=0.68
FACIAL_ATTEMPT_MAX_AGE_SECONDS=120
BIOMETRIC_AWAY_POLICY=bloquear
JOURNEY_DEFAULT_TIMEZONE=America/Sao_Paulo
JOURNEY_OPEN_GRACE_HOURS=12
JOURNEY_EARLY_TOLERANCE_MINUTES=10
JOURNEY_LATE_TOLERANCE_MINUTES=10
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/database
CLOUDINARY_CLOUD_NAME=optional
CLOUDINARY_API_KEY=optional
CLOUDINARY_API_SECRET=optional
EMAILJS_SERVICE_ID=optional
EMAILJS_TEMPLATE_ID=optional
EMAILJS_PUBLIC_KEY=optional
EMAILJS_PRIVATE_KEY=optional
ATTACHMENT_SCAN_MODE=async
ATTACHMENT_QUEUE_PROVIDER=sqs
ATTACHMENT_QUEUE_URL=https://sqs.sa-east-1.amazonaws.com/000000000000/replace-me
ATTACHMENT_QUEUE_VISIBILITY_SECONDS=120
ATTACHMENT_QUEUE_MAX_RECEIVES=5

