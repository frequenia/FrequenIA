# Application (required)
APP_ENV=development
FLASK_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_SECRET

# Application (optional defaults)
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_TEST_KEY=
# E-mail de recuperação (EmailJS)
EMAILJS_SERVICE_ID=CHANGE_ME
EMAILJS_TEMPLATE_ID=CHANGE_ME
EMAILJS_PUBLIC_KEY=CHANGE_ME
# Opcional; configure se o serviço EmailJS exigir autenticação privada.
EMAILJS_PRIVATE_KEY=
EMAILJS_TIMEOUT_SECONDS=10
TOMTOM_API_KEY=
TOMTOM_TIMEOUT_SECONDS=5
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Default from DeepFace 0.0.99 for ArcFace/cosine; calibrate before a real pilot.
FACE_VERIFICATION_MAX_COSINE_DISTANCE=0.68
# Política server-side do vínculo afastado: bloquear, revogar ou preservar.
BIOMETRIC_AWAY_POLICY=bloquear
# Maximum age of a successful facial attempt accepted for a clock event.
FACIAL_ATTEMPT_MAX_AGE_SECONDS=120
# Motor de jornada; tolerâncias são apenas informativas nesta fase.
JOURNEY_DEFAULT_TIMEZONE=UTC
JOURNEY_OPEN_GRACE_HOURS=12
JOURNEY_EARLY_TOLERANCE_MINUTES=10
JOURNEY_LATE_TOLERANCE_MINUTES=10
PORT=5000

# PostgreSQL (required for login and data APIs)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Comprovantes de correção (piloto): diretório privado, fora de static/ e do Git.
ATTACHMENT_STORAGE_ROOT=
ATTACHMENT_STORAGE_PROVIDER=local
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_ENDPOINT_URL=
ATTACHMENT_SCANNER_PROVIDER=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
CLAMAV_SIGNATURE_MAX_AGE_HOURS=48
ATTACHMENT_SCAN_MODE=async
ATTACHMENT_QUEUE_PROVIDER=
ATTACHMENT_QUEUE_URL=
ATTACHMENT_DLQ_URL=
ATTACHMENT_QUEUE_ENDPOINT_URL=
ATTACHMENT_QUEUE_VISIBILITY_SECONDS=120
ATTACHMENT_QUEUE_MAX_RECEIVES=5
ATTACHMENT_WORKER_BATCH_SIZE=2
ATTACHMENT_WORKER_LEASE_SECONDS=120
ATTACHMENT_OUTBOX_MAX_BACKOFF_SECONDS=300
ATTACHMENT_RETENTION_DAYS=90
ATTACHMENT_INFECTED_RETENTION_DAYS=30

# Continuidade local: valores de produção permanecem pendentes de aprovação formal.
CONTINUITY_RPO_SECONDS=3600
CONTINUITY_RTO_SECONDS=7200
CONTINUITY_FREQUENCY_HOURS=24
CONTINUITY_BACKUP_RETENTION_DAYS=30
CONTINUITY_EXERCISE_WINDOW_MINUTES=60
CONTINUITY_MAX_SET_BYTES=1073741824
CONTINUITY_PRODUCTION_APPROVED=false
CONTINUITY_APPROVAL_REFERENCE=

# Cloudinary (required only by the legacy facial enrollment flow)
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
